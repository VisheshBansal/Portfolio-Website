{
  "name": "visheshbansal",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "author": "Vishesh Bansal (https://github.com/VisheshBansal)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run build",
    "deploy": "npm run verify && wrangler deploy",
    "deploy:preview": "npm run verify && wrangler versions upload --preview-alias v2"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "astro": "7.4.7",
    "gsap": "3.15.1",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.158.0"
  }
}
