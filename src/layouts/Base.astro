---
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/martian-mono/wght.css';
import '@fontsource-variable/caveat/wght.css';
import '../styles/global.css';
import anton from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import shareImage from '../assets/og.jpg';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Kept out of search results (404): no canonical, no og:url. */
  noindex?: boolean;
}
const {
  title = person.name,
  description = 'Vishesh Bansal builds products from zero, secures them, and leads the teams behind them. Global Director of Security and Customer Success at BalkanID.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL('/', Astro.site);
const shareImageUrl = new URL(shareImage.src, Astro.site);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vishesh Bansal',
  jobTitle: 'Global Director of Security and Customer Success',
  worksFor: { '@type': 'Organization', name: 'BalkanID' },
  alumniOf: 'Vellore Institute of Technology',
  url: home.href,
  sameAs: ['https://www.linkedin.com/in/bansalvishesh', 'https://github.com/VisheshBansal', 'https://medium.com/@visheshbansal'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#eaf0f8" />
    <link rel="preload" href={anton} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={`${person.name} in front of the Golden Gate Bridge on a foggy day`} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Pre-paint bootstrap. Must stay inline and dependency-free; keys mirror lib/theme.ts and lib/intro.ts, colours mirror --bg. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        if (!location.hash) window.scrollTo(0, 0);
        let theme = null;
        try {
          theme = localStorage.getItem('vb-theme');
          const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!calm && !sessionStorage.getItem('vb-intro')) root.classList.add('intro-on');
        } catch {
          // Storage blocked: fall back to the system theme and skip the intro gate.
        }
        if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        const dark = theme === 'dark' || (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0b1117' : '#eaf0f8');
        // Failsafe: never leave content hidden if scripts fail to load. A running intro owns the reveal.
        const failsafe = setTimeout(() => {
          root.classList.add('ready');
          root.classList.remove('intro-on');
        }, 6000);
        addEventListener('vb:intro-start', () => clearTimeout(failsafe), { once: true });
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
