---
/**
 * Travel globe, modelled on GitHub's: arcs rise between visited places and ripple where they land; hover or tap a pin or
 * an arc to name it. The globe is decorative, so the full list stays in the page for assistive tech and becomes visible
 * only when there is no globe (no script or no WebGL2).
 */
import { travel as copy } from '../../data/copy';
import { places } from '../../data/travel';

const countries = [...new Set(places.map((place) => place.country))].map((name) => ({
  name,
  places: places.filter((place) => place.country === name),
}));
const noun = (value: number, one: string, many: string) => (value === 1 ? one : many);
const lines = [
  { value: places.length, word: noun(places.length, 'place.', 'places.') },
  { value: countries.length, word: noun(countries.length, 'country.', 'countries.') },
];
const headline = lines.map((line) => `${line.value} ${line.word}`).join(' ');
---

<section id="places" class="places" aria-labelledby="places-title" data-places>
  <div class="places__inner wrap">
    <header class="places__head">
      <p class="places__kicker mono">{copy.kicker}</p>
      <h2 id="places-title" class="places__title display">
        <span class="sr-only">{headline}</span>
        {/* The numbers count up on screen; assistive tech reads the settled headline above. */}
        <span aria-hidden="true">
          {lines.map((line) => (
            <span class="places__line">
              <span class="places__num" data-count-to={line.value}>
                {line.value}
              </span>{' '}
              {line.word}
            </span>
          ))}
        </span>
      </h2>
      <p class="places__note hand">{copy.note}</p>
      {/* Both only make sense once the globe runs, so script reveals them. */}
      <div class="places__controls">
        <p class="places__hint mono" data-globe-hint data-touch={copy.hintTouch} hidden>
          {copy.hint}
        </p>
        <button type="button" class="places__toggle mono" data-tour-toggle data-play={copy.play} data-pause={copy.pause} hidden>
          {copy.pause}
        </button>
      </div>
    </header>

    <div class="places__stage">
      <div class="places__globe" data-globe-wrap>
        <div class="places__body" aria-hidden="true"></div>
        <canvas class="places__canvas" data-globe aria-hidden="true"></canvas>
        <p class="places__tip mono" data-globe-tip aria-hidden="true">
          <span data-tip-main></span>
          <span class="places__tip-sub" data-tip-sub></span>
        </p>
      </div>
    </div>

    <div class="places__list" data-places-list>
      {countries.map((country) => (
        <div class="places__country">
          <h3 class="places__country-name mono">{country.name}</h3>
          <ul class="places__names" role="list">
            {country.places.map((place) => (
              <li>{place.name}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .places {
    padding-block: clamp(96px, 16vh, 200px);
  }
  .places__inner {
    display: grid;
    gap: clamp(28px, 4vw, 64px);
  }
  .places__kicker,
  .places__hint,
  .places__country-name {
    color: var(--muted);
  }
  .places__title {
    margin-top: 0.25em;
    font-size: var(--step-3);
  }
  .places__line {
    display: block;
  }
  .places__num {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .places__note {
    margin-top: 0.3em;
    font-size: clamp(1.4rem, 1rem + 1.1vw, 2.1rem);
    transform: rotate(-3deg);
    transform-origin: left center;
  }
  .places__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    margin-top: clamp(20px, 3vh, 32px);
  }
  .places__toggle {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .places__globe {
    position: relative;
    width: min(100%, 760px, 86svh);
    aspect-ratio: 1;
    margin-inline: auto;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    /* Vertical swipes still scroll the page; horizontal drags spin the globe. */
    touch-action: pan-y;
  }
  .places__globe:active {
    cursor: grabbing;
  }
  /*
   * The planet: night in either theme, lit from the top left like the dots on it, grounded by a contact shadow on the
   * light page and by its own glow on the dark one. Inset 10% matches the 0.4 radius in lib/webgl/globe.ts.
   */
  .places__body {
    --planet: radial-gradient(circle at 32% 26%, #24384b 0%, #16222e 45%, #0e151c 100%);
    --planet-glow: 0 0 46px -6px rgb(111 168 220 / 0.3), 0 50px 80px -50px rgb(14 21 28 / 0.55);
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: var(--planet);
    box-shadow:
      inset 0 0 0 1px rgb(170 200 240 / 0.22),
      inset -22px -30px 70px rgb(0 0 0 / 0.45),
      inset 16px 20px 44px rgb(120 170 220 / 0.12),
      var(--planet-glow);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .places__body {
      --planet: radial-gradient(circle at 32% 26%, #2a3f55 0%, #17212b 50%, #0b1117 100%);
      --planet-glow: 0 0 90px -10px rgb(90 150 220 / 0.22);
    }
  }
  :global(:root[data-theme='dark']) .places__body {
    --planet: radial-gradient(circle at 32% 26%, #2a3f55 0%, #17212b 50%, #0b1117 100%);
    --planet-glow: 0 0 90px -10px rgb(90 150 220 / 0.22);
  }
  /* A thin band of atmosphere just past the limb. */
  .places__body::after {
    content: '';
    position: absolute;
    inset: -2.5%;
    border-radius: 50%;
    background: radial-gradient(closest-side, transparent 90%, rgb(111 168 220 / 0.3) 95.5%, transparent 100%);
    filter: blur(3px);
  }
  .places__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Script places it beside the pointer and keeps it inside the globe's box. Dark glass, to read on the night planet. */
  .places__tip {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    gap: 0.7em;
    padding: 7px 12px;
    border: 1px solid rgb(170 200 240 / 0.22);
    border-radius: 999px;
    background: rgb(14 21 28 / 0.78);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #e8eef5;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
    pointer-events: none;
  }
  .places__tip[data-on] {
    opacity: 1;
  }
  .places__tip-sub {
    opacity: 0.65;
  }
  .places__tip-sub:empty {
    display: none;
  }

  /* The globe needs script; without it the list stands alone. */
  :global(html:not(.js)) .places__stage {
    display: none;
  }
  /* With a globe the list is for assistive tech only; without one (data-flat) it shows. */
  :global(.js) .places__list:not([data-flat]) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .places__list {
    display: grid;
    gap: clamp(18px, 3vh, 28px);
  }
  .places__country-name {
    margin-bottom: 8px;
  }
  .places__names {
    display: flex;
    flex-wrap: wrap;
    row-gap: 4px;
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .places__names li:not(:last-child)::after {
    content: '·';
    /* Empty alt text: a separator, not something to read aloud. */
    content: '·' / '';
    padding-inline: 0.45em;
    color: var(--muted);
  }

  @media (min-width: 1024px) {
    .places__inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: center;
    }
    .places__list {
      grid-column: 1;
    }
  }
</style>

<script>
  import { whenIdle } from '../../lib/motion';
  import { initPlaces } from './places.client';
  whenIdle(initPlaces);
</script>
