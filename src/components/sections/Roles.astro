---
/** Range: every hat on one split-flap board, then the TL;DR. The grid is laid out here; roles.client.ts animates it. */
import { career } from '../../data/career';
import { roles } from '../../data/copy';
import { person } from '../../data/site';
import { padNumber } from '../../lib/format';

/** The board widens from its longest word up to MAX_COLUMNS, trying to fit each role on TARGET_ROWS rows. */
const MAX_COLUMNS = 14;
const TARGET_ROWS = 2;
/** Phrases set in the accent colour in the TL;DR. */
const SUMMARY_KEYWORDS: readonly string[] = ['Builder at heart', 'security', 'infrastructure', '0 to 1'];
const HYPHENATED = /(\S+-\S+)/;
const WHOLLY_HYPHENATED = /^\S+-\S+$/;

interface SummaryPart {
  readonly text: string;
  /** range__kw marks a keyword, range__nb a hyphenated word kept whole; plain text has none. */
  readonly className: 'range__kw' | 'range__nb' | null;
}

const splitWords = (text: string) => text.trim().split(/\s+/);
const escapeRegExp = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

/** Greedy word wrap into rows of at most `columns` characters. */
function wrapRows(text: string, columns: number): string[] {
  const rows: string[] = [];
  let row = '';
  for (const word of splitWords(text)) {
    if (!row) row = word;
    else if (row.length + 1 + word.length <= columns) row += ` ${word}`;
    else {
      rows.push(row);
      row = word;
    }
  }
  rows.push(row);
  return rows;
}

/** Fewest columns that keep every label within TARGET_ROWS rows. */
function fitColumns(labels: readonly string[]): number {
  let columns = Math.max(...labels.flatMap((label) => splitWords(label).map((word) => word.length)));
  while (columns < MAX_COLUMNS && labels.some((label) => wrapRows(label, columns).length > TARGET_ROWS)) columns++;
  return columns;
}

/** One string per label, wrapped and blank padded so every frame fills the same grid. */
function toFrames(labels: readonly string[], columns: number): string[] {
  const wrapped = labels.map((label) => wrapRows(label, columns));
  const rowCount = Math.max(...wrapped.map((rows) => rows.length));
  return wrapped.map((rows) => {
    while (rows.length < rowCount) rows.push('');
    return rows.map((row) => row.padEnd(columns, ' ')).join('');
  });
}

/** Splits the summary into accent keywords, hyphenated words that must not break, and plain text. */
function toSummaryParts(summary: string): SummaryPart[] {
  const keywordPattern = new RegExp(`(${SUMMARY_KEYWORDS.map(escapeRegExp).join('|')})`);
  return summary
    .split(keywordPattern)
    .filter(Boolean)
    .flatMap((chunk): SummaryPart[] => {
      if (SUMMARY_KEYWORDS.includes(chunk)) return [{ text: chunk, className: 'range__kw' }];
      return chunk
        .split(HYPHENATED)
        .filter(Boolean)
        .map((text): SummaryPart => ({ text, className: WHOLLY_HYPHENATED.test(text) ? 'range__nb' : null }));
    });
}

const labels = roles.map((role) => role.toUpperCase());
const columns = fitColumns(labels);
const frames = toFrames(labels, columns);
const landingFrame = frames.at(-1);
if (landingFrame === undefined) throw new Error('Roles needs at least one role');
const landingGlyphs = [...landingFrame].map((glyph) => glyph.trim());
const lastRole = frames.length - 1;
const tickLeft = (index: number) => (lastRole ? (index / lastRole) * 100 : 0);
const counterSteps = Array.from({ length: frames.length + 1 }, (_, index) => padNumber(index));
const firstYear = Math.min(...career.map((job) => Number.parseInt(job.start, 10)).filter(Number.isFinite));
const hatsSince = Number.isFinite(firstYear) ? `Collecting hats since ${firstYear}` : 'Collecting hats';
const summaryParts = toSummaryParts(person.summary);
---

<section class="range" id="range" aria-labelledby="range-title" data-range>
  <div class="range__stage" data-stage>
    <div class="range__inner wrap">
      <p class="range__kicker mono" data-kicker>
        <span>Range</span>
        <i class="range__rule" aria-hidden="true"></i>
        <span>{hatsSince}</span>
      </p>

      <h2 class="range__title display" id="range-title" data-title>
        <span class="range__line">
          One person<span class="range__dot">.</span>
        </span>{' '}
        <span class="range__line range__line--2">
          Many hats<span class="range__dot">.</span>
        </span>
      </h2>
      <ul class="range__hats sr-only mono" aria-label="Hats worn">
        {roles.map((role) => (
          <li>{role}</li>
        ))}
      </ul>

      <div class="range__rig" data-rig style={`--cols:${columns}`}>
        <div class="board" data-board data-frames={JSON.stringify(frames)} data-cols={columns} data-state="locked" aria-hidden="true">
          <div class="board__bar">
            <span class="board__status mono">
              <i class="board__led"></i>
              <span data-status>Locked in</span>
            </span>
            <span class="board__rail">
              {frames.map((_, index) => (
                <i class="board__tick" style={`left:${tickLeft(index)}%`}></i>
              ))}
              <i class="board__fill" data-fill></i>
            </span>
            <span class="board__count mono">
              <span class="board__count-k">Hats worn</span>
              <span>
                <span class="reel">
                  <span class="reel__strip" data-reel style={`--k:${frames.length}`}>
                    {counterSteps.map((step) => (
                      <span>{step}</span>
                    ))}
                  </span>
                </span>
                /{padNumber(frames.length)}
              </span>
            </span>
          </div>

          <div class="board__flaps">
            <div class="board__grid" data-grid>
              {landingGlyphs.map((glyph) => {
                const tone = glyph ? 'hot' : undefined;
                return (
                  <span class="cell">
                    <span class="half half--top" data-tone={tone}>
                      <span class="g">{glyph}</span>
                    </span>
                    <span class="half half--bot" data-tone={tone}>
                      <span class="g">{glyph}</span>
                    </span>
                    <span class="leaf leaf--top">
                      <span class="g"></span>
                      <i class="leaf__fx"></i>
                    </span>
                    <span class="leaf leaf--bot">
                      <span class="g"></span>
                      <i class="leaf__fx"></i>
                    </span>
                  </span>
                );
              })}
            </div>
          </div>

          <svg class="board__ul" viewBox="0 0 1000 64" focusable="false">
            <path data-ul pathLength="1" d="M10 24C140 16 300 13 470 15C640 17 790 25 912 19C946 17 970 13 990 6" />
            <path data-ul pathLength="1" d="M952 38C800 45 590 49 360 46C290 45 236 44 190 43" />
          </svg>
        </div>

        <div class="range__foot">
          <button type="button" class="range__spin mono" data-spin hidden aria-label="Spin the hat board again">
            <svg class="range__spin-ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M13.6 8.6A5.6 5.6 0 1 1 11.9 3.9M12.4 1.4v3h-3" />
            </svg>
            Spin again
          </button>
          <p class="range__note hand" data-note aria-hidden="true">
            <svg class="range__arrow" viewBox="0 0 64 48" focusable="false">
              <path data-arrow pathLength="1" d="M61 45C45 43 24 33 11 10M3 21L11 10L23 14" />
            </svg>
            the one that never comes off
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="range__tldr wrap" data-tldr>
    <p class="range__tldr-k mono">
      <abbr title="Too long; didn't read">TL;DR</abbr>
    </p>
    <p class="range__summary" data-summary>
      {summaryParts.map((part) => (part.className ? <span class={part.className}>{part.text}</span> : part.text))}
    </p>
  </div>
</section>

<style>
  .range {
    --pad: clamp(10px, min(1.5vw, 2.6svh), 22px);
    --gap: clamp(3px, 0.45vw, 7px);
    --cw-max: 10svh;
    --shade: light-dark(var(--contrast-bg), var(--contrast-fg));
    --shine: light-dark(var(--contrast-fg), var(--contrast-bg));
    position: relative;
    background: var(--bg);
    color: var(--fg);
  }

  .range__stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(64px, 11svh, 128px) clamp(24px, 4svh, 56px);
    background: var(--bg);
  }
  @media (min-height: 560px) {
    .range__stage {
      min-height: 100svh;
    }
  }

  .range__kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--fg-2);
  }
  .range__rule {
    flex: 1;
    min-width: 24px;
    height: 1px;
    background: var(--rule);
  }

  .range__title {
    margin-top: clamp(14px, 2.6svh, 34px);
    font-size: min(var(--step-5), 12.5svh, 17.5vw);
  }
  .range__line {
    display: block;
    white-space: nowrap;
  }
  .range__dot {
    color: var(--accent);
  }

  /* Read by screen readers; shown as a plain index when motion is off. */
  @media (prefers-reduced-motion: reduce) {
    .range__hats {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 22px;
      width: auto;
      height: auto;
      margin: clamp(16px, 2.6svh, 30px) 0 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      color: var(--fg-2);
    }
    .range__hats li::before {
      content: '';
      display: inline-block;
      width: 5px;
      height: 5px;
      margin-right: 9px;
      border-radius: 50%;
      vertical-align: 2px;
      background: var(--accent);
    }
  }

  .range__rig {
    container-type: inline-size;
    margin-top: clamp(20px, 3.6svh, 48px);
    width: min(100%, calc(var(--cols) * var(--cw-max) + (var(--cols) - 1) * var(--gap) + 2 * var(--pad)));
  }
  @media (min-width: 900px) {
    .range__line--2 {
      padding-left: 1.1em;
    }
    .range__rig {
      margin-left: auto;
    }
  }

  /* Housing */
  .board {
    --flap-base: color-mix(in srgb, var(--contrast-fg) 9%, var(--contrast-bg));
    position: relative;
    padding: var(--pad);
    border-radius: clamp(12px, 1.4vw, 22px);
    background: var(--contrast-bg);
    color: var(--contrast-muted);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--shine) 12%, transparent),
      0 44px 70px -44px color-mix(in srgb, var(--shade) 75%, transparent);
  }
  .board__bar {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    margin-bottom: clamp(8px, 1.5svh, 16px);
  }
  .board__status {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    min-width: 19ch;
    white-space: nowrap;
  }
  .board__led {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--contrast-muted);
    outline: 1px solid color-mix(in srgb, var(--contrast-fg) 22%, transparent);
    outline-offset: 1px;
  }
  .board[data-state='busy'] .board__led {
    background: var(--accent);
  }
  .board[data-state='busy'] .board__led::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    --ping-opacity: 0.8;
    animation: ping 1.1s var(--ease-out) infinite;
  }
  .board[data-state='set'] .board__led {
    background: var(--contrast-fg);
  }
  .board[data-state='locked'] .board__led {
    background: var(--signal);
  }
  .board__rail {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 9px;
  }
  .board__rail::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4px;
    height: 1px;
    background: color-mix(in srgb, var(--contrast-muted) 45%, transparent);
  }
  .board__tick {
    position: absolute;
    top: 1px;
    bottom: 1px;
    width: 1px;
    margin-left: -0.5px;
    background: var(--contrast-muted);
  }
  .board__fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 3.5px;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
  }
  .board__count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    white-space: nowrap;
  }
  .reel {
    display: inline-block;
    height: 1.5em;
    overflow: hidden;
    vertical-align: top;
    color: var(--contrast-fg);
  }
  .reel__strip {
    display: block;
    transform: translateY(calc(-100% * var(--k) / (var(--k) + 1)));
  }
  .reel__strip > span {
    display: block;
    height: 1.5em;
  }
  @media (max-width: 640px) {
    .board__rail {
      display: none;
    }
    .board__status {
      min-width: 0;
    }
    .board__bar {
      justify-content: space-between;
    }
  }
  @media (max-width: 400px) {
    .board__count-k {
      display: none;
    }
  }

  /* Flaps */
  .board__flaps {
    container-type: inline-size;
  }
  .board__grid {
    --cw: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
    --h: calc(var(--cw) * 1.4);
    --hinge: max(1px, calc(var(--h) * 0.014));
    --r: calc(var(--cw) * 0.07);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap);
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: calc(var(--cw) * 1.02);
    line-height: var(--h);
    color: var(--contrast-fg);
  }
  .cell {
    position: relative;
    height: var(--h);
    perspective: calc(var(--h) * 4);
  }
  .cell::before,
  .cell::after {
    content: '';
    position: absolute;
    z-index: 4;
    top: 50%;
    width: max(2px, calc(var(--cw) * 0.05));
    height: calc(var(--h) * 0.1);
    translate: 0 -50%;
    border-radius: 1px;
    background: color-mix(in srgb, var(--contrast-muted) 55%, var(--contrast-bg));
  }
  .cell::before {
    left: 0;
  }
  .cell::after {
    right: 0;
  }
  .half,
  .leaf {
    --flap: var(--flap-base);
    position: absolute;
    left: 0;
    right: 0;
    height: calc((var(--h) - var(--hinge)) / 2);
    overflow: hidden;
  }
  .half[data-tone='hot'],
  .leaf[data-tone='hot'] {
    --flap: var(--accent);
  }
  .half--top,
  .leaf--top {
    top: 0;
    border-radius: var(--r) var(--r) 1px 1px;
    background: color-mix(in srgb, var(--shine) 4%, var(--flap));
  }
  .half--bot,
  .leaf--bot {
    bottom: 0;
    border-radius: 1px 1px var(--r) var(--r);
    background: color-mix(in srgb, var(--shade) 7%, var(--flap));
  }
  .leaf {
    z-index: 2;
    visibility: hidden;
    will-change: transform;
  }
  .leaf--top {
    transform-origin: 50% 100%;
  }
  .leaf--bot {
    transform-origin: 50% 0;
    transform: rotateX(90deg);
  }
  .g {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--h);
    text-align: center;
    transform: translateY(var(--shift, 0.006em));
  }
  .half--top .g,
  .leaf--top .g {
    top: 0;
  }
  .half--bot .g,
  .leaf--bot .g {
    bottom: 0;
  }
  .leaf__fx {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .leaf--top .leaf__fx {
    background: var(--shade);
  }
  .leaf--bot .leaf__fx {
    background: var(--shine);
  }

  /* Ink */
  .board__ul {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 100%;
    width: 100%;
    height: auto;
    margin-top: 0.6%;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--accent);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .board__ul path,
  .range__arrow path {
    stroke-dasharray: 1 1.2;
    stroke-dashoffset: 0;
  }

  .range__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px 28px;
    margin-top: max(clamp(20px, 3.4svh, 42px), 6.2%);
  }
  .range__spin {
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    padding: 0.85em 1.2em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--fg);
  }
  .range__spin[hidden] {
    display: none;
  }
  .range__spin:focus-visible {
    border-radius: 999px;
  }
  .range__spin-ico {
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.7s var(--ease-out);
  }
  .range__spin:hover .range__spin-ico,
  .range__spin:focus-visible .range__spin-ico {
    transform: rotate(360deg);
  }

  .range__note {
    position: relative;
    margin-left: auto;
    max-width: 15em;
    padding-left: 1.7em;
    font-size: clamp(var(--step-1), 4.6cqi, var(--step-2));
    text-align: right;
    text-wrap: balance;
    transform: rotate(-3deg);
    transform-origin: 100% 50%;
  }
  .range__arrow {
    position: absolute;
    left: 0;
    top: -0.75em;
    width: 1.45em;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 900px) {
    .range__note {
      max-width: none;
      white-space: nowrap;
    }
  }

  /* TL;DR */
  .range__tldr {
    display: grid;
    gap: clamp(14px, 2vw, 26px);
    padding-block: clamp(56px, 10vh, 140px) clamp(96px, 16vh, 220px);
  }
  .range__tldr-k {
    color: var(--fg-2);
    padding-top: 0.5em;
  }
  .range__tldr-k abbr {
    text-decoration: none;
    cursor: help;
  }
  .range__summary {
    max-width: 17em;
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }
  .range__kw {
    color: var(--accent);
  }
  .range__kw,
  .range__nb {
    white-space: nowrap;
  }
  @media (min-width: 600px) {
    .range__summary {
      font-size: var(--step-3);
    }
  }
  @media (min-width: 900px) {
    .range__tldr {
      grid-template-columns: minmax(0, 2fr) minmax(0, 10fr);
    }
  }
</style>

<script>
  import { whenIdle } from '../../lib/motion';
  import { initRoles } from './roles.client';
  whenIdle(initRoles);
</script>
